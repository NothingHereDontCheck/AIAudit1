{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/"}},"html":"<!DOCTYPE html><!--cafIrnW1ZYxHeKr_B_Kzn--><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/afe9230332574b34.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-2eb758dea75faf50.js\"/><script src=\"/_next/static/chunks/4bd1b696-c023c6e3521b1417.js\" async=\"\"></script><script src=\"/_next/static/chunks/255-4f212684648fcab9.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-e171d81f5c99d3aa.js\" async=\"\"></script><script src=\"/_next/static/chunks/619-ba102abea3e3d0e4.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-81df3d6295256260.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/page-938f8fa73c6648ab.js\" async=\"\"></script><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"/><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\"/><title>AI Security Audit for SMBs | AITrustAudit.com</title><meta name=\"description\" content=\"Professional AI security audit reports for small and medium businesses. Get a clear picture of your AI risk in 5 business days. Starting at $499.\"/><link rel=\"author\" href=\"https://www.aitrustaudit.com/about\"/><meta name=\"author\" content=\"Jamel Rainey\"/><link rel=\"manifest\" href=\"/site.webmanifest\"/><meta name=\"keywords\" content=\"AI security audit,AI risk assessment,SMB AI security,shadow AI,AI compliance\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow\"/><meta property=\"og:title\" content=\"AI Security Audit for SMBs | AITrustAudit.com\"/><meta property=\"og:description\" content=\"Professional AI security audit reports for small and medium businesses. Get a clear picture of your AI risk in 5 business days. Starting at $499.\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"AI Security Audit for SMBs | AITrustAudit.com\"/><meta name=\"twitter:description\" content=\"Professional AI security audit reports for small and medium businesses. Starting at $499.\"/><meta name=\"twitter:image\" content=\"https://www.aitrustaudit.com/og-default.png\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\"/><link rel=\"apple-touch-icon\" href=\"/favicon.svg\"/><link href=\"https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&amp;family=Rajdhani:wght@300;400;500;600;700&amp;display=swap\" rel=\"stylesheet\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"antialiased font-body\"><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main-content\" class=\"skip-nav\">Skip to main content</a><header class=\"fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-navy\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4\"><a class=\"flex items-center gap-2.5 focus:outline-none focus:ring-2 focus:ring-teal-lt rounded-md\" aria-label=\"AITrustAudit home\" href=\"/\"><svg width=\"32\" height=\"32\" viewBox=\"0 0 96 96\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"\" aria-hidden=\"true\" style=\"filter:drop-shadow(0 0 12px rgba(0,200,255,0.6))\"><path d=\"M48 8 L82 22 L82 52 C82 68 66 82 48 88 C30 82 14 68 14 52 L14 22 Z\" stroke=\"#00ACC1\" stroke-width=\"2.5\" fill=\"#0D1B2A\"></path><path d=\"M48 16 L74 28 L74 52 C74 64 62 75 48 80 C34 75 22 64 22 52 L22 28 Z\" fill=\"#00796B\" opacity=\"0.25\"></path><text x=\"48\" y=\"58\" text-anchor=\"middle\" font-family=\"Orbitron, sans-serif\" font-size=\"22\" font-weight=\"700\" fill=\"#00