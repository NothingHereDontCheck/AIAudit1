{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/audit/layout,_N_T_/audit/page,_N_T_/audit"}},"html":"<!DOCTYPE html><!--cafIrnW1ZYxHeKr_B_Kzn--><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/afe9230332574b34.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-2eb758dea75faf50.js\"/><script src=\"/_next/static/chunks/4bd1b696-c023c6e3521b1417.js\" async=\"\"></script><script src=\"/_next/static/chunks/255-4f212684648fcab9.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-e171d81f5c99d3aa.js\" async=\"\"></script><script src=\"/_next/static/chunks/619-ba102abea3e3d0e4.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-81df3d6295256260.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/audit/page-da53eff32f99a335.js\" async=\"\"></script><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"/><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\"/><title>AI Security Audit Service | $499–$2,499 | AITrustAudit.com</title><meta name=\"description\" content=\"Comprehensive AI security audit reports covering Shadow AI, data handling, vendor risk, and compliance. Delivered in 5 business days. No retainer required.\"/><link rel=\"author\" href=\"https://www.aitrustaudit.com/about\"/><meta name=\"author\" content=\"Jamel Rainey\"/><link rel=\"manifest\" href=\"/site.webmanifest\"/><meta name=\"keywords\" content=\"AI security audit,AI risk assessment,SMB AI security,shadow AI,AI compliance\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow\"/><meta property=\"og:title\" content=\"AI Security Audit Service | $499–$2,499 | AITrustAudit.com\"/><meta property=\"og:description\" content=\"Comprehensive AI security audit reports covering Shadow AI, data handling, vendor risk, and compliance. Delivered in 5 business days. No retainer required.\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"AI Security Audit for SMBs | AITrustAudit.com\"/><meta name=\"twitter:description\" content=\"Professional AI security audit reports for small and medium businesses. Starting at $499.\"/><meta name=\"twitter:image\" content=\"https://www.aitrustaudit.com/og-default.png\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\"/><link rel=\"apple-touch-icon\" href=\"/favicon.svg\"/><link href=\"https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&amp;family=Rajdhani:wght@300;400;500;600;700&amp;display=swap\" rel=\"stylesheet\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"antialiased font-body\"><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main-content\" class=\"skip-nav\">Skip to main content</a><header class=\"fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-navy\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4\"><a class=\"flex items-center gap-2.5 focus:outline-none focus:ring-2 focus:ring-teal-lt rounded-md\" aria-label=\"AITrustAudit home\" href=\"/\"><svg width=\"32\" height=\"32\" viewBox=\"0 0 96 96\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"\" aria-hidden=\"true\" style=\"filter:drop-shadow(0 0 12px rgba(0,200,255,0.6))\"><path d=\"M48 8 L82 22 L82 52 C82 68 66 82 48 88 C30 82 14 68 14 52 L14 22 Z\" stroke=\"#00ACC1\" stroke-width=\"2.5\" fill=\"#0D1B2A\"></path><path d=\"M48 16 L74 28 L74 52 C74 64 62 75 48 80 C34 75 22 64 22 52 L22 28 Z\" fill=\"#00796B\" opacity=\"0.25\"></path><text x=\"48\" y=\"58\" text-anchor=\"middle\" font-family=\"Orbitron, sans-serif\" font-size=\"22\" font-weight=\"700\" fill=\"#00ACC1\" letter-spacing=\"2\">AI</text><circle cx=\"48\" cy=\"8\" r=\"3\" fill=\"#00ACC1\"></circle><circle cx=\"82\" cy=\"22\" r=\"2.5\" fill=\"#00796B\"></circle><circle cx=\"14\" cy=\"22\" r=\"2.5\" fill=\"#00796B\"></circle></svg><div class=\"hidden sm:block\"><span class=\"font-display text-white text-sm font-bold tracking-wide\">AITrustAudit</span><span class=\"font-display text-teal-lt text-sm font-bold\">.com</span></div></a><nav class=\"hidden md:flex items-center gap-1\" aria-label=\"Main navigation\"><a class=\"font-body font-semibold text-sm text-gray-300 hover:text-teal-lt px-3 py-2 rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-teal-lt\" href=\"/audit\">Audit Service</a><a class=\"font-body font-semibold text-sm text-gray-300 hover:text-teal-lt px-3 py-2 rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-teal-lt\" href=\"/course\">Course</a><a class=\"font-body font-semibold text-sm text-gray-300 hover:text-teal-lt px-3 py-2 rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-teal-lt\" href=\"/blog\">Blog</a><a class=\"font-body font-semibold text-sm text-gray-300 hover:text-teal-lt px-3 py-2 rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-teal-lt\" href=\"/about\">About</a></nav><div class=\"hidden md:flex items-center gap-3\"><a class=\"font-body font-semibold text-sm text-teal-lt hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-teal-lt rounded-md px-2 py-1\" href=\"/free-risk-overview\">Free Risk Overview</a><a href=\"https://calendly.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"bg-teal hover:bg-teal-lt text-white font-display font-bold text-xs px-4 py-2 rounded-lg tracking-wide transition-colors focus:outline-none focus:ring-2 focus:ring-teal-lt\">Book Discovery Call</a></div><button class=\"md:hidden text-gray-300 hover:text-white focus:outline-none focus:ring-2 focus:ring-teal-lt rounded-md p-1\" aria-label=\"Open menu\" aria-expanded=\"false\"><svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16M4 18h16\"></path></svg></button></div></header><main id=\"main-content\" class=\"pt-16\"><section class=\"relative bg-navy py-24 px-4 overflow-hidden scanlines\"><svg class=\"absolute inset-0 w-full h-full pointer-events-none \" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\" style=\"opacity:0.12\"><defs><pattern id=\"circuit-grid\" x=\"0\" y=\"0\" width=\"80\" height=\"80\" patternUnits=\"userSpaceOnUse\"><line x1=\"0\" y1=\"40\" x2=\"80\" y2=\"40\" stroke=\"#00ACC1\" stroke-width=\"0.8\"></line><line x1=\"0\" y1=\"0\" x2=\"80\" y2=\"0\" stroke=\"#00796B\" stroke-width=\"0.5\"></line><line x1=\"0\" y1=\"80\" x2=\"80\" y2=\"80\" stroke=\"#00796B\" stroke-width=\"0.5\"></line><line x1=\"40\" y1=\"0\" x2=\"40\" y2=\"80\" stroke=\"#00ACC1\" stroke-width=\"0.8\"></line><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"80\" stroke=\"#00796B\" stroke-width=\"0.5\"></line><line x1=\"80\" y1=\"0\" x2=\"80\" y2=\"80\" stroke=\"#00796B\" stroke-width=\"0.5\"></line><circle cx=\"40\" cy=\"40\" r=\"2.5\" fill=\"#00ACC1\"></circle><circle cx=\"0\" cy=\"0\" r=\"1.5\" fill=\"#00796B\"></circle><circle cx=\"80\" cy=\"0\" r=\"1.5\" fill=\"#00796B\"></circle><circle cx=\"0\" cy=\"80\" r=\"1.5\" fill=\"#00796B\"></circle><circle cx=\"80\" cy=\"80\" r=\"1.5\" fill=\"#00796B\"></circle><circle cx=\"40\" cy=\"0\" r=\"1\" fill=\"#00ACC1\"></circle><circle cx=\"40\" cy=\"80\" r=\"1\" fill=\"#00ACC1\"></circle><circle cx=\"0\" cy=\"40\" r=\"1\" fill=\"#00ACC1\"></circle><circle cx=\"80\" cy=\"40\" r=\"1\" fill=\"#00ACC1\"></circle><line x1=\"30\" y1=\"40\" x2=\"40\" y2=\"40\" stroke=\"#00ACC1\" stroke-width=\"1.2\"></line><line x1=\"40\" y1=\"30\" x2=\"40\" y2=\"40\" stroke=\"#00ACC1\" stroke-width=\"1.2\"></line><line x1=\"55\" y1=\"40\" x2=\"65\" y2=\"40\" stroke=\"#00796B\" stroke-width=\"0.8\"></line><line x1=\"65\" y1=\"30\" x2=\"65\" y2=\"40\" stroke=\"#00796B\" stroke-width=\"0.8\"></line><circle cx=\"65\" cy=\"40\" r=\"1.5\" fill=\"#00796B\"></circle><circle cx=\"65\" cy=\"30\" r=\"1.5\" fill=\"#00796B\"></circle><line x1=\"15\" y1=\"40\" x2=\"25\" y2=\"40\" stroke=\"#00796B\" stroke-width=\"0.8\"></line><line x1=\"15\" y1=\"40\" x2=\"15\" y2=\"50\" stroke=\"#00796B\" stroke-width=\"0.8\"></line><circle cx=\"15\" cy=\"40\" r=\"1.5\" fill=\"#00796B\"></circle><circle cx=\"15\" cy=\"50\" r=\"1.5\" fill=\"#00796B\"></circle></pattern></defs><rect width=\"100%\" height=\"100%\" fill=\"url(#circuit-grid)\"></rect></svg><div class=\"absolute top-0 right-0 w-96 h-96 bg-teal/8 rounded-full blur-[120px] pointer-events-none\"></div><div class=\"relative z-10 max-w-4xl mx-auto text-center\"><p class=\"section-label mb-4\">// AI SECURITY AUDIT SERVICE</p><h1 class=\"font-display text-white text-4xl md:text-5xl font-black leading-tight mb-6 text-glow\">Find Out Exactly Where Your AI Stack Is Exposed</h1><p class=\"font-body text-gray-300 text-xl mb-8 max-w-2xl mx-auto leading-relaxed\">A professional AI Security Audit Report delivered in 5 business days. No retainer. No fluff. Just the truth about your AI risk.</p><a href=\"https://calendly.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-flex items-center justify-center bg-teal hover:bg-teal-lt text-white font-display font-bold text-sm px-8 py-4 rounded-lg tracking-wide transition-all duration-200 shadow-lg shadow-teal/30 focus:outline-none focus:ring-2 focus:ring-teal-lt focus:ring-offset-2 focus:ring-offset-navy\">Book a Free 20-Minute Discovery Call</a><p class=\"font-body text-gray-500 text-sm mt-4\">No commitment required. No sales pressure.</p></div></section><section class=\"bg-white py-20 px-4\"><div class=\"max-w-7xl mx-auto\"><div class=\"max-w-3xl mx-auto mb-12 text-center\"><p class=\"section-label mb-3\">// THE PROBLEM</p><h2 class=\"font-display text-navy text-3xl font-bold mb-4\">Your Team Is Using AI Tools You Don’t Know About</h2><p class=\"font-body text-mid-gray text-lg\">80% of unauthorized AI activity comes from inside the organization. That’s not a technology problem — it’s a governance problem. And it’s creating real liability right now.</p></div><div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-6\"><div class=\"relative bg-white rounded-lg shadow-md border border-divider overflow-hidden hover:shadow-lg transition-shadow duration-200\" style=\"border-left:4px solid #B71C1C\"><div class=\"p-6\"><div class=\"flex items-center justify-between mb-3\"><span class=\"text-xs font-display font-bold px-2.5 py-1 rounded-full badge-critical\" style=\"letter-spacing:0.08em\">CRITICAL</span><span class=\"text-3xl font-display font-black text-divider\">0<!-- -->1</span></div><h3 class=\"font-display text-navy text-base font-bold mb-2 leading-tight\">Shadow AI: The Invisible Attack Surface</h3><p class=\"text-mid-gray text-sm mb-4 font-body leading-relaxed\">Your team is using AI tools you&#x27;ve never approved, vetted, or even seen. ChatGPT, Claude, Gemini, and dozens of niche tools are running on company devices right now. Each one is a data channel you don&#x27;t control.</p><div class=\"rounded-md p-3 text-sm font-body font-semibold\" style=\"background:#B71C1C18;color:#B71C1C;border-left:3px solid #B71C1C\">Can you name every AI tool active in your organization right now?</div></div></div><div class=\"relative bg-white rounded-lg shadow-md border border-divider overflow-hidden hover:shadow-lg transition-shadow duration-200\" style=\"border-left:4px solid #E65100\"><div class=\"p-6\"><div class=\"flex items-center justify-between mb-3\"><span class=\"text-xs font-display font-bold px-2.5 py-1 rounded-full badge-high\" style=\"letter-spacing:0.08em\">HIGH</span><span class=\"text-3xl font-display font-black text-divider\">0<!-- -->2</span></div><h3 class=\"font-display text-navy text-base font-bold mb-2 leading-tight\">Client Data in AI Training Pipelines</h3><p class=\"text-mid-gray text-sm mb-4 font-body leading-relaxed\">Employees pasting client contracts, PII, and financial data into AI tools without realizing that data may be retained and used for model training. One paste can become a breach across thousands of future users.</p><div class=\"rounded-md p-3 text-sm font-body font-semibold\" style=\"background:#E6510018;color:#E65100;border-left:3px solid #E65100\">Has your team ever pasted client or employee data into an AI tool?</div></div></div><div class=\"relative bg-white rounded-lg shadow-md border border-divider overflow-hidden hover:shadow-lg transition-shadow duration-200\" style=\"border-left:4px solid #E65100\"><div class=\"p-6\"><div class=\"flex items-center justify-between mb-3\"><span class=\"text-xs font-display font-bold px-2.5 py-1 rounded-full badge-high\" style=\"letter-spacing:0.08em\">HIGH</span><span class=\"text-3xl font-display font-black text-divider\">0<!-- -->3</span></div><h3 class=\"font-display text-navy text-base font-bold mb-2 leading-tight\">No AI Acceptable Use Policy</h3><p class=\"text-mid-gray text-sm mb-4 font-body leading-relaxed\">Without a policy, you have no baseline, no enforcement mechanism, and no legal protection when something goes wrong. Your cyber insurer will ask. Your enterprise clients will ask. You need an answer.</p><div class=\"rounded-md p-3 text-sm font-body font-semibold\" style=\"background:#E6510018;color:#E65100;border-left:3px solid #E65100\">Do you have a written AI Acceptable Use Policy signed by your employees?</div></div></div><div class=\"relative bg-white rounded-lg shadow-md border border-divider overflow-hidden hover:shadow-lg transition-shadow duration-200\" style=\"border-left:4px solid #E65100\"><div class=\"p-6\"><div class=\"flex items-center justify-between mb-3\"><span class=\"text-xs font-display font-bold px-2.5 py-1 rounded-full badge-high\" style=\"letter-spacing:0.08em\">HIGH</span><span class=\"text-3xl font-display font-black text-divider\">0<!-- -->4</span></div><h3 class=\"font-display text-navy text-base font-bold mb-2 leading-tight\">Compliance Exposure (HIPAA, GDPR, SOC 2)</h3><p class=\"text-mid-gray text-sm mb-4 font-body leading-relaxed\">HIPAA requires a BAA for any vendor handling PHI — most AI providers won&#x27;t sign one. GDPR requires documented lawful basis for processing in AI systems. SOC 2 auditors are increasingly asking about AI controls.</p><div class=\"rounded-md p-3 text-sm font-body font-semibold\" style=\"background:#E6510018;color:#E65100;border-left:3px solid #E65100\">Have you formally mapped your AI stack against your compliance obligations?</div></div></div><div class=\"relative bg-white rounded-lg shadow-md border border-divider overflow-hidden hover:shadow-lg transition-shadow duration-200\" style=\"border-left:4px solid #00ACC1\"><div class=\"p-6\"><div class=\"flex items-center justify-between mb-3\"><span class=\"text-xs font-display font-bold px-2.5 py-1 rounded-full badge-medium\" style=\"letter-spacing:0.08em\">MEDIUM</span><span class=\"text-3xl font-display font-black text-divider\">0<!-- -->5</span></div><h3 class=\"font-display text-navy text-base font-bold mb-2 leading-tight\">Unchecked AI Vendor &amp; Third-Party Risk</h3><p class=\"text-mid-gray text-sm mb-4 font-body leading-relaxed\">Every AI vendor is a potential supply chain risk. When was the last time you reviewed their security posture, data retention terms, incident response SLA, or sub-processor list?</p><div class=\"rounded-md p-3 text-sm font-body font-semibold\" style=\"background:#00ACC118;color:#00ACC1;border-left:3px solid #00ACC1\">When did you last review the security documentation for your AI vendors?</div></div></div></div></div></section><section class=\"bg-light-bg py-20 px-4\"><div class=\"max-w-7xl mx-auto\"><div class=\"text-center mb-12\"><p class=\"section-label mb-3\">// AUDIT TIERS</p><h2 class=\"font-display text-navy text-3xl font-bold mb-4\">Choose Your Engagement Level</h2><p class=\"font-body text-mid-gray text-lg max-w-xl mx-auto\">Every tier includes a professional audit report. Choose based on the size and complexity of your AI stack.</p></div><div class=\"grid md:grid-cols-3 gap-6 items-start\"><div class=\"relative rounded-xl flex flex-col border border-divider bg-white\"><div class=\"p-7 flex flex-col h-full text-navy\"><div class=\"mb-5\"><h3 class=\"font-display text-lg font-bold mb-1 text-navy\">Basic</h3><div class=\"flex items-end gap-1\"><span class=\"font-display text-4xl font-black text-navy\">$499</span><span class=\"text-sm mb-1.5 font-body text-mid-gray\">/engagement</span></div></div><div class=\"w-full h-px mb-5 bg-divider\"></div><ul class=\"space-y-3 mb-6 flex-1\"><li class=\"flex items-start gap-2 text-sm font-body\"><span class=\"text-teal-lt mt-0.5 shrink-0\">▸</span><span><strong class=\"text-navy\">AI Tools Assessed<!-- -->:</strong> <span class=\"text-mid-gray\">Up to 3</span></span></li><li class=\"flex items-start gap-2 text-sm font-body\"><span class=\"text-teal-lt mt-0.5 shrink-0\">▸</span><span><strong class=\"text-navy\">Intake Method<!-- -->:</strong> <span class=\"text-mid-gray\">15-question intake form</span></span></li><li class=\"flex items-start gap-2 text-sm font-body\"><span class=\"text-teal-lt mt-0.5 shrink-0\">▸</span><span><strong class=\"text-navy\">Calls Included<!-- -->:</strong> <span class=\"text-mid-gray\">1 discovery call</span></span></li><li class=\"flex items-start gap-2 text-sm font-body\"><span class=\"text-teal-lt mt-0.5 shrink-0\">▸</span><span><strong class=\"text-navy\">Report Length<!-- -->:</strong> <span class=\"text-mid-gray\">8–12 pages</span></span></li></ul><div class=\"rounded-lg p-3 mb-5 text-xs font-body bg-light-bg text-mid-gray\"><strong class=\"text-navy\">Deliverable:</strong> <!-- -->Professional PDF audit report with findings, risk score, and prioritized recommendations<br/><strong class=\"text-navy\">Turnaround:</strong> <!-- -->5 business days</div><a href=\"https://calendly.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"block text-center py-3 px-5 rounded-lg font-display font-bold text-sm tracking-wide transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-teal focus:ring-offset-2 bg-navy text-white hover:bg-teal\">Get Started — Basic</a></div></div><div class=\"relative rounded-xl flex flex-col border-2 border-teal shadow-2xl shadow-teal/20 bg-navy scale-[1.02]\"><div class=\"absolute -top-3.5 left-1/2 -translate-x-1/2\"><span class=\"bg-teal text-white font-display text-xs font-bold px-4 py-1 rounded-full tracking-widest uppercase\">Most Popular</span></div><div class=\"p-7 flex flex-col h-full text-white\"><div class=\"mb-5\"><h3 class=\"font-display text-lg font-bold mb-1 text-teal-lt\">Standard</h3><div class=\"flex items-end gap-1\"><span class=\"font-display text-4xl font-black text-white text-glow\">$999</span><span class=\"text-sm mb-1.5 font-body text-gray-400\">/engagement</span></div></div><div class=\"w-full h-px mb-5 bg-teal/30\"></div><ul class=\"space-y-3 mb-6 flex-1\"><li class=\"flex items-start gap-2 text-sm font-body\"><span class=\"text-teal-lt mt-0.5 shrink-0\">▸</span><span><strong class=\"text-gray-200\">AI Tools Assessed<!-- -->:</strong> <span class=\"text-gray-400\">Up to 8</span></span></li><li class=\"flex items-start gap-2 text-sm font-body\"><span class=\"text-teal-lt mt-0.5 shrink-0\">▸</span><span><strong class=\"text-gray-200\">Intake Method<!-- -->:</strong> <span class=\"text-gray-400\">Full intake + data flow review</span></span></li><li class=\"flex items-start gap-2 text-sm font-body\"><span class=\"text-teal-lt mt-0.5 shrink-0\">▸</span><span><strong class=\"text-gray-200\">Calls Included<!-- -->:</strong> <span class=\"text-gray-400\">2 calls (discovery + debrief)</span></span></li><li class=\"flex items-start gap-2 text-sm font-body\"><span class=\"text-teal-lt mt-0.5 shrink-0\">▸</span><span><strong class=\"text-gray-200\">Report Length<!-- -->:</strong> <span class=\"text-gray-400\">15–25 pages</span></span></li></ul><div class=\"rounded-lg p-3 mb-5 text-xs font-body bg-teal/10 text-gray-300\"><strong class=\"text-teal-lt\">Deliverable:</strong> <!-- -->Full report + risk matrix with Critical/High/Medium/Low classification<br/><strong class=\"text-teal-lt\">Turnaround:</strong> <!-- -->5 business days</div><a href=\"https://calendly.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"block text-center py-3 px-5 rounded-lg font-display font-bold text-sm tracking-wide transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-teal focus:ring-offset-2 bg-teal text-white hover:bg-teal-lt\">Get Started — Standard</a></div></div><div class=\"relative rounded-xl flex flex-col border border-divider bg-white\"><div class=\"p-7 flex flex-col h-full text-navy\"><div class=\"mb-5\"><h3 class=\"font-display text-lg font-bold mb-1 text-navy\">Enterprise</h3><div class=\"flex items-end gap-1\"><span class=\"font-display text-4xl font-black text-navy\">$2,499</span><span class=\"text-sm mb-1.5 font-body text-mid-gray\">/engagement</span></div></div><div class=\"w-full h-px mb-5 bg-divider\"></div><ul class=\"space-y-3 mb-6 flex-1\"><li class=\"flex items-start gap-2 text-sm font-body\"><span class=\"text-teal-lt mt-0.5 shrink-0\">▸</span><span><strong class=\"text-navy\">AI Tools Assessed<!-- -->:</strong> <span class=\"text-mid-gray\">Unlimited</span></span></li><li class=\"flex items-start gap-2 text-sm font-body\"><span class=\"text-teal-lt mt-0.5 shrink-0\">▸</span><span><strong class=\"text-navy\">Intake Method<!-- -->:</strong> <span class=\"text-mid-gray\">Full intake + team interviews</span></span></li><li class=\"flex items-start gap-2 text-sm font-body\"><span class=\"text-teal-lt mt-0.5 shrink-0\">▸</span><span><strong class=\"text-navy\">Calls Included<!-- -->:</strong> <span class=\"text-mid-gray\">Full engagement</span></span></li><li class=\"flex items-start gap-2 text-sm font-body\"><span class=\"text-teal-lt mt-0.5 shrink-0\">▸</span><span><strong class=\"text-navy\">Report Length<!-- -->:</strong> <span class=\"text-mid-gray\">Full report</span></span></li></ul><div class=\"rounded-lg p-3 mb-5 text-xs font-body bg-light-bg text-mid-gray\"><strong class=\"text-navy\">Deliverable:</strong> <!-- -->Full report + risk matrix + 90-day prioritized remediation roadmap<br/><strong class=\"text-navy\">Turnaround:</strong> <!-- -->7 business days</div><a href=\"https://calendly.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"block text-center py-3 px-5 rounded-lg font-display font-bold text-sm tracking-wide transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-teal focus:ring-offset-2 bg-navy text-white hover:bg-teal\">Get Started — Enterprise</a></div></div></div></div></section><section class=\"bg-white py-20 px-4\"><div class=\"max-w-7xl mx-auto\"><div class=\"text-center mb-12\"><p class=\"section-label mb-3\">// REPORT CONTENTS</p><h2 class=\"font-display text-navy text-3xl font-bold mb-4\">What’s in Your Audit Report</h2><p class=\"font-body text-mid-gray text-lg max-w-xl mx-auto\">Every report follows the same structured format so you know exactly what you’re getting — and can act on it immediately.</p></div><div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-5\"><div class=\"relative bg-light-bg rounded-xl p-6 border border-divider\"><div class=\"text-3xl mb-3\" aria-hidden=\"true\">📊</div><h3 class=\"font-display text-navy text-sm font-bold mb-2\">Executive Summary</h3><p class=\"font-body text-mid-gray text-sm leading-relaxed\">Overall AI risk score (1–10), top 3 critical findings, and a plain-English summary your leadership team can actually read.</p></div><div class=\"relative bg-light-bg rounded-xl p-6 border border-divider\"><div class=\"text-3xl mb-3\" aria-hidden=\"true\">🗂️</div><h3 class=\"font-display text-navy text-sm font-bold mb-2\">AI Tool Inventory</h3><p class=\"font-body text-mid-gray text-sm leading-relaxed\">Every AI tool in scope, classified by risk level, data handling practices, and current governance status.</p></div><div class=\"relative bg-light-bg rounded-xl p-6 border border-divider\"><div class=\"text-3xl mb-3\" aria-hidden=\"true\">⚠️</div><h3 class=\"font-display text-navy text-sm font-bold mb-2\">Findings &amp; Risk Matrix</h3><p class=\"font-body text-mid-gray text-sm leading-relaxed\">All findings rated Critical / High / Medium / Low with supporting evidence and impact assessment.</p></div><div class=\"relative bg-light-bg rounded-xl p-6 border border-divider\"><div class=\"text-3xl mb-3\" aria-hidden=\"true\">⚖️</div><h3 class=\"font-display text-navy text-sm font-bold mb-2\">Compliance Gap Analysis</h3><p class=\"font-body text-mid-gray text-sm leading-relaxed\">Mapped against HIPAA, SOC 2, and GDPR requirements as applicable to your organization.</p></div><div class=\"relative bg-light-bg rounded-xl p-6 border border-divider\"><div class=\"text-3xl mb-3\" aria-hidden=\"true\">🛠️</div><h3 class=\"font-display text-navy text-sm font-bold mb-2\">Remediation Recommendations</h3><p class=\"font-body text-mid-gray text-sm leading-relaxed\">Prioritized action list. Every finding has a corresponding fix — no vague &#x27;improve your security posture&#x27; recommendations.</p></div><div class=\"relative bg-light-bg rounded-xl p-6 border border-divider\"><div class=\"text-3xl mb-3\" aria-hidden=\"true\">🗺️</div><h3 class=\"font-display text-navy text-sm font-bold mb-2\">30/60/90-Day Roadmap</h3><p class=\"font-body text-mid-gray text-sm leading-relaxed\">Enterprise tier only. A sequenced implementation plan so you know what to fix first and why.</p></div></div></div></section><section class=\"relative bg-navy py-20 px-4 overflow-hidden\"><svg class=\"absolute inset-0 w-full h-full pointer-events-none \" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\" style=\"opacity:0.08\"><defs><pattern id=\"circuit-grid\" x=\"0\" y=\"0\" width=\"80\" height=\"80\" patternUnits=\"userSpaceOnUse\"><line x1=\"0\" y1=\"40\" x2=\"80\" y2=\"40\" stroke=\"#00ACC1\" stroke-width=\"0.8\"></line><line x1=\"0\" y1=\"0\" x2=\"80\" y2=\"0\" stroke=\"#00796B\" stroke-width=\"0.5\"></line><line x1=\"0\" y1=\"80\" x2=\"80\" y2=\"80\" stroke=\"#00796B\" stroke-width=\"0.5\"></line><line x1=\"40\" y1=\"0\" x2=\"40\" y2=\"80\" stroke=\"#00ACC1\" stroke-width=\"0.8\"></line><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"80\" stroke=\"#00796B\" stroke-width=\"0.5\"></line><line x1=\"80\" y1=\"0\" x2=\"80\" y2=\"80\" stroke=\"#00796B\" stroke-width=\"0.5\"></line><circle cx=\"40\" cy=\"40\" r=\"2.5\" fill=\"#00ACC1\"></circle><circle cx=\"0\" cy=\"0\" r=\"1.5\" fill=\"#00796B\"></circle><circle cx=\"80\" cy=\"0\" r=\"1.5\" fill=\"#00796B\"></circle><circle cx=\"0\" cy=\"80\" r=\"1.5\" fill=\"#00796B\"></circle><circle cx=\"80\" cy=\"80\" r=\"1.5\" fill=\"#00796B\"></circle><circle cx=\"40\" cy=\"0\" r=\"1\" fill=\"#00ACC1\"></circle><circle cx=\"40\" cy=\"80\" r=\"1\" fill=\"#00ACC1\"></circle><circle cx=\"0\" cy=\"40\" r=\"1\" fill=\"#00ACC1\"></circle><circle cx=\"80\" cy=\"40\" r=\"1\" fill=\"#00ACC1\"></circle><line x1=\"30\" y1=\"40\" x2=\"40\" y2=\"40\" stroke=\"#00ACC1\" stroke-width=\"1.2\"></line><line x1=\"40\" y1=\"30\" x2=\"40\" y2=\"40\" stroke=\"#00ACC1\" stroke-width=\"1.2\"></line><line x1=\"55\" y1=\"40\" x2=\"65\" y2=\"40\" stroke=\"#00796B\" stroke-width=\"0.8\"></line><line x1=\"65\" y1=\"30\" x2=\"65\" y2=\"40\" stroke=\"#00796B\" stroke-width=\"0.8\"></line><circle cx=\"65\" cy=\"40\" r=\"1.5\" fill=\"#00796B\"></circle><circle cx=\"65\" cy=\"30\" r=\"1.5\" fill=\"#00796B\"></circle><line x1=\"15\" y1=\"40\" x2=\"25\" y2=\"40\" stroke=\"#00796B\" stroke-width=\"0.8\"></line><line x1=\"15\" y1=\"40\" x2=\"15\" y2=\"50\" stroke=\"#00796B\" stroke-width=\"0.8\"></line><circle cx=\"15\" cy=\"40\" r=\"1.5\" fill=\"#00796B\"></circle><circle cx=\"15\" cy=\"50\" r=\"1.5\" fill=\"#00796B\"></circle></pattern></defs><rect width=\"100%\" height=\"100%\" fill=\"url(#circuit-grid)\"></rect></svg><div class=\"relative z-10 max-w-7xl mx-auto\"><div class=\"text-center mb-12\"><p class=\"section-label mb-3\">// AUDIT METHODOLOGY</p><h2 class=\"font-display text-white text-3xl font-bold mb-4 text-glow\">The 6-Domain AI Security Audit Framework</h2><p class=\"font-body text-gray-400 text-lg max-w-2xl mx-auto mb-3\">Every audit follows a structured 6-domain methodology aligned to the leading AI security frameworks.</p><div class=\"flex flex-wrap justify-center gap-3 text-xs font-display font-bold\"><span class=\"px-3 py-1.5 rounded-full border border-teal/40 text-teal-lt\">NIST AI RMF 1.0</span><span class=\"px-3 py-1.5 rounded-full border border-teal/40 text-teal-lt\">OWASP LLM Top 10</span><span class=\"px-3 py-1.5 rounded-full border border-teal/40 text-teal-lt\">ISO/IEC 42001</span><span class=\"px-3 py-1.5 rounded-full border border-teal/40 text-teal-lt\">NIST CSF 2.0</span></div></div><div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-5\"><div class=\"bg-white/5 rounded-xl p-6 border border-white/10 hover:border-teal/40 transition-colors\"><div class=\"font-display text-teal-lt text-xs font-bold mb-2 opacity-60\">01</div><h3 class=\"font-display text-white text-sm font-bold mb-2\">AI Tool Inventory</h3><p class=\"font-body text-gray-400 text-sm leading-relaxed\">Identify and document every AI tool in use — approved and unapproved.</p></div><div class=\"bg-white/5 rounded-xl p-6 border border-white/10 hover:border-teal/40 transition-colors\"><div class=\"font-display text-teal-lt text-xs font-bold mb-2 opacity-60\">02</div><h3 class=\"font-display text-white text-sm font-bold mb-2\">Data Classification &amp; Handling</h3><p class=\"font-body text-gray-400 text-sm leading-relaxed\">Map what data types are flowing into AI systems and how they&#x27;re being processed.</p></div><div class=\"bg-white/5 rounded-xl p-6 border border-white/10 hover:border-teal/40 transition-colors\"><div class=\"font-display text-teal-lt text-xs font-bold mb-2 opacity-60\">03</div><h3 class=\"font-display text-white text-sm font-bold mb-2\">Access Controls &amp; Identity</h3><p class=\"font-body text-gray-400 text-sm leading-relaxed\">Evaluate who has access to AI tools and whether least privilege is enforced.</p></div><div class=\"bg-white/5 rounded-xl p-6 border border-white/10 hover:border-teal/40 transition-colors\"><div class=\"font-display text-teal-lt text-xs font-bold mb-2 opacity-60\">04</div><h3 class=\"font-display text-white text-sm font-bold mb-2\">Vendor &amp; Third-Party Risk</h3><p class=\"font-body text-gray-400 text-sm leading-relaxed\">Review AI vendor security posture, contractual protections, and sub-processor risks.</p></div><div class=\"bg-white/5 rounded-xl p-6 border border-white/10 hover:border-teal/40 transition-colors\"><div class=\"font-display text-teal-lt text-xs font-bold mb-2 opacity-60\">05</div><h3 class=\"font-display text-white text-sm font-bold mb-2\">Policy &amp; Governance</h3><p class=\"font-body text-gray-400 text-sm leading-relaxed\">Assess whether AI-specific policies exist, are current, and are actually enforced.</p></div><div class=\"bg-white/5 rounded-xl p-6 border border-white/10 hover:border-teal/40 transition-colors\"><div class=\"font-display text-teal-lt text-xs font-bold mb-2 opacity-60\">06</div><h3 class=\"font-display text-white text-sm font-bold mb-2\">Compliance Alignment</h3><p class=\"font-body text-gray-400 text-sm leading-relaxed\">Map AI tool usage against applicable regulatory requirements.</p></div></div></div></section><section class=\"bg-white py-20 px-4\"><div class=\"max-w-3xl mx-auto\"><div class=\"text-center mb-12\"><p class=\"section-label mb-3\">// FAQ</p><h2 class=\"font-display text-navy text-3xl font-bold\">Common Questions</h2></div><div class=\"space-y-5\"><div class=\"rounded-xl border border-divider p-6\"><h3 class=\"font-display text-navy text-sm font-bold mb-2\">How long does the audit take?</h3><p class=\"font-body text-mid-gray text-sm leading-relaxed\">5–7 business days from intake completion, depending on tier. Enterprise engagements are 7 business days.</p></div><div class=\"rounded-xl border border-divider p-6\"><h3 class=\"font-display text-navy text-sm font-bold mb-2\">Do I need technical staff for this?</h3><p class=\"font-body text-mid-gray text-sm leading-relaxed\">No. The intake process is designed for non-technical business owners and operations managers. You describe what you&#x27;re using and how — I do the technical analysis.</p></div><div class=\"rounded-xl border border-divider p-6\"><h3 class=\"font-display text-navy text-sm font-bold mb-2\">What do I do with the report?</h3><p class=\"font-body text-mid-gray text-sm leading-relaxed\">The report gives you a prioritized action list with specific next steps for each finding. If you need help implementing the recommendations, that&#x27;s a separate engagement we can discuss.</p></div><div class=\"rounded-xl border border-divider p-6\"><h3 class=\"font-display text-navy text-sm font-bold mb-2\">Is my data safe during the audit?</h3><p class=\"font-body text-mid-gray text-sm leading-relaxed\">Yes. All data is stored encrypted, retained for 90 days post-engagement, and covered under a data processing agreement provided at intake. I don&#x27;t share client data with any third party.</p></div><div class=\"rounded-xl border border-divider p-6\"><h3 class=\"font-display text-navy text-sm font-bold mb-2\">Can this help with HIPAA or SOC 2 compliance?</h3><p class=\"font-body text-mid-gray text-sm leading-relaxed\">Yes. Compliance gap analysis against HIPAA, SOC 2, and GDPR is included in every tier. The report documents where your AI stack creates compliance exposure and what controls would address it.</p></div><div class=\"rounded-xl border border-divider p-6\"><h3 class=\"font-display text-navy text-sm font-bold mb-2\">What&#x27;s the difference between an audit report and a penetration test?</h3><p class=\"font-body text-mid-gray text-sm leading-relaxed\">A penetration test looks for technical exploits in your systems. An AI security audit assesses your governance, data handling practices, policy posture, and vendor risk — the human and process layer that pen tests typically miss.</p></div></div></div></section><section class=\"relative bg-navy py-16 px-4 overflow-hidden\"><div class=\"absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-teal via-teal-lt to-teal\"></div><div class=\"max-w-3xl mx-auto text-center\"><h2 class=\"font-display text-white text-2xl md:text-3xl font-bold mb-4 text-glow\">Book Your Free 20-Minute AI Risk Discovery Call</h2><p class=\"font-body text-gray-400 text-lg mb-8 max-w-xl mx-auto\">Find out exactly where your AI stack is exposed. No commitment required. Proposal delivered within 2 hours of the call.</p><div class=\"flex flex-col sm:flex-row gap-4 justify-center\"><a href=\"https://calendly.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block bg-teal hover:bg-teal-lt text-white font-display font-bold text-sm py-4 px-8 rounded-lg tracking-wide transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-teal-lt focus:ring-offset-2 focus:ring-offset-navy\">Book a Free Discovery Call</a><a href=\"/free-risk-overview\" class=\"inline-block border border-teal-lt/50 hover:border-teal-lt text-teal-lt hover:text-white font-display font-bold text-sm py-4 px-8 rounded-lg tracking-wide transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-teal-lt focus:ring-offset-2 focus:ring-offset-navy\">Download Free Risk Overview</a></div></div></section><!--$--><!--/$--></main><footer class=\"bg-navy\" aria-label=\"Site footer\"><div class=\"border-t border-white/10 px-4 py-10\"><div class=\"max-w-4xl mx-auto text-center\"><p class=\"section-label mb-2\">// THE AI TRUST BRIEFING</p><h3 class=\"font-display text-white text-lg font-bold mb-2\">The AI Security Newsletter for Practitioners Who Do the Work</h3><p class=\"font-body text-gray-400 text-sm mb-6\">Real threats. Real frameworks. No enterprise fluff. Weekly.</p><div class=\"max-w-md mx-auto\"><div><form class=\"flex flex-col sm:flex-row gap-3\"><input type=\"email\" required=\"\" placeholder=\"Your email address\" class=\"flex-1 px-4 py-3 rounded-lg bg-navy border border-teal/40 text-white placeholder-gray-500 font-body text-sm focus:outline-none focus:ring-2 focus:ring-teal-lt\" value=\"\"/><button type=\"submit\" class=\"bg-teal hover:bg-teal-lt text-white font-display font-bold text-sm px-6 py-3 rounded-lg tracking-wide transition-colors whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-teal-lt disabled:opacity-60\">Get Free Overview</button></form></div></div></div></div><div class=\"border-t border-white/10 px-4 py-12\"><div class=\"max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-8\"><div class=\"col-span-2 md:col-span-1\"><a class=\"flex items-center gap-2 mb-3 focus:outline-none focus:ring-2 focus:ring-teal-lt rounded-md w-fit\" href=\"/\"><svg width=\"32\" height=\"32\" viewBox=\"0 0 96 96\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"\" aria-hidden=\"true\" style=\"filter:drop-shadow(0 0 12px rgba(0,200,255,0.6))\"><path d=\"M48 8 L82 22 L82 52 C82 68 66 82 48 88 C30 82 14 68 14 52 L14 22 Z\" stroke=\"#00ACC1\" stroke-width=\"2.5\" fill=\"#0D1B2A\"></path><path d=\"M48 16 L74 28 L74 52 C74 64 62 75 48 80 C34 75 22 64 22 52 L22 28 Z\" fill=\"#00796B\" opacity=\"0.25\"></path><text x=\"48\" y=\"58\" text-anchor=\"middle\" font-family=\"Orbitron, sans-serif\" font-size=\"22\" font-weight=\"700\" fill=\"#00ACC1\" letter-spacing=\"2\">AI</text><circle cx=\"48\" cy=\"8\" r=\"3\" fill=\"#00ACC1\"></circle><circle cx=\"82\" cy=\"22\" r=\"2.5\" fill=\"#00796B\"></circle><circle cx=\"14\" cy=\"22\" r=\"2.5\" fill=\"#00796B\"></circle></svg><span cl