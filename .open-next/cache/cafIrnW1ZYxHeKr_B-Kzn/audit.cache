ity\":\"high\",\"number\":3,\"title\":\"No AI Acceptable Use Policy\",\"description\":\"Without a policy, you have no baseline, no enforcement mechanism, and no legal protection when something goes wrong. Your cyber insurer will ask. Your enterprise clients will ask. You need an answer.\",\"question\":\"Do you have a written AI Acceptable Use Policy signed by your employees?\"}],[\"$\",\"$L12\",\"4\",{\"severity\":\"high\",\"number\":4,\"title\":\"Compliance Exposure (HIPAA, GDPR, SOC 2)\",\"description\":\"HIPAA requires a BAA for any vendor handling PHI — most AI providers won't sign one. GDPR requires documented lawful basis for processing in AI systems. SOC 2 auditors are increasingly asking about AI controls.\",\"question\":\"Have you formally mapped your AI stack against your compliance obligations?\"}],[\"$\",\"$L12\",\"5\",{\"severity\":\"medium\",\"number\":5,\"title\":\"Unchecked AI Vendor & Third-Party Risk\",\"description\":\"Every AI vendor is a potential supply chain risk. When was the last time you reviewed their security posture, data retention terms, incident response SLA, or sub-processor list?\",\"question\":\"When did you last review the security documentation for your AI vendors?\"}]]}]\na:[\"$\",\"section\",null,{\"className\":\"bg-light-bg py-20 px-4\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-7xl mx-auto\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-center mb-12\",\"children\":[[\"$\",\"p\",null,{\"className\":\"section-label mb-3\",\"children\":\"// AUDIT TIERS\"}],[\"$\",\"h2\",null,{\"className\":\"font-display text-navy text-3xl font-bold mb-4\",\"children\":\"Choose Your Engagement Level\"}],[\"$\",\"p\",null,{\"className\":\"font-body text-mid-gray text-lg max-w-xl mx-auto\",\"children\":\"Every tier includes a professional audit report. Choose based on the size and complexity of your AI stack.\"}]]}],[\"$\",\"div\",null,{\"className\":\"grid md:grid-cols-3 gap-6 items-start\",\"children\":[[\"$\",\"$L13\",\"Ba