{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/"}},"html":"<!DOCTYPE html><!--94KkDw33iMGMeWWUT1K_w--><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/c098a84fd5ac198d.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-2eb758dea75faf50.js\"/><script src=\"/_next/static/chunks/4bd1b696-c023c6e3521b1417.js\" async=\"\"></script><script src=\"/_next/static/chunks/255-4f212684648fcab9.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-e171d81f5c99d3aa.js\" async=\"\"></script><script src=\"/_next/static/chunks/619-ba102abea3e3d0e4.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-53019e87a5ec8e44.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/page-8e293021cb0385c0.js\" async=\"\"></script><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"/><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\"/><title>AI Security Engineering Learning Platform | AITrustAudit.com</title><meta name=\"description\" content=\"Master AI security auditing with practitioner-level courses, frameworks, and tools. Built for security professionals, GRC teams, and engineers who have to do the actual work.\"/><link rel=\"author\" href=\"https://www.aitrustaudit.com/about\"/><meta name=\"author\" content=\"Jamel Rainey\"/><link rel=\"manifest\" href=\"/site.webmanifest\"/><meta name=\"keywords\" content=\"AI security,AI security engineering,AI audit course,LLM security,AI risk,shadow AI,AI compliance\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow\"/><meta property=\"og:title\" content=\"AI Security Engineering Learning Platform | AITrustAudit.com\"/><meta property=\"og