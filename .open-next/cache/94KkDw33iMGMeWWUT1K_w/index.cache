opacity=\"0.25\"></path><text x=\"48\" y=\"58\" text-anchor=\"middle\" font-family=\"Orbitron, sans-serif\" font-size=\"22\" font-weight=\"700\" fill=\"#00ACC1\" letter-spacing=\"2\">AI</text><circle cx=\"48\" cy=\"8\" r=\"3\" fill=\"#00ACC1\"></circle><circle cx=\"82\" cy=\"22\" r=\"2.5\" fill=\"#00796B\"></circle><circle cx=\"14\" cy=\"22\" r=\"2.5\" fill=\"#00796B\"></circle></svg><div class=\"hidden sm:block\"><span class=\"font-display text-white text-sm font-bold tracking-wide\">AITrustAudit</span><span class=\"font-display text-teal-lt text-sm font-bold\">.com</span></div></a><nav class=\"hidden md:flex items-center gap-1\" aria-label=\"Main navigation\"><a class=\"font-body font-semibold text-sm text-gray-300 hover:text-teal-lt px-3 py-2 rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-teal-lt\" href=\"/resources\">Free Resources</a><a class=\"font-body font-semibold text-sm text-gray-300 hover:text-teal-lt px-3 py-2 rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-teal-lt\" href=\"/course\">Course</a><a class=\"font-body font-semibold text-sm text-gray-300 hover:text-teal-lt px-3 py-2 rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-teal-lt\" href=\"/blog\">Blog</a><a class=\"font-body font-semibold text-sm text-gray-300 hover:text-teal-lt px-3 py-2 rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-teal-lt\" href=\"/about\">About</a></nav><div class=\"hidden md:flex items-center gap-3\"><a class=\"bg-teal hover:bg-teal-lt text-white font-display font-bold text-xs px-4 py-2 rounded-lg tracking-wide transition-colors focus:outline-none focus:ring-2 focus:ring-teal-lt\" href=\"/course\">Enroll Now</a></div><button class=\"md:hidden text-gray-300 hover:text-white focus:outline-none focus:ring-2 focus:ring-teal-lt rounded-md p-1\" aria-label=\"Open menu\" aria-expanded=\"false\"><svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16M4 18h16\"></path></svg></button></div></header><main id=\"main-content\" class=\"pt-16\"><section class=\"relative bg-navy min-h-[90vh] flex items-center overflow-hidden scanlines\"><svg class=\"absolute inset-0 w-full h-full pointer-events-none \" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\" style=\"opacity:0.12\"><defs><pattern id=\"circuit-grid\" x=\"0\" y=\"0\" width=\"80\" height=\"80\" patternUnits=\"userSpaceOnUse\"><line x1=\"0\" y1=\"40\" x2=\"80\" y2=\"40\" stroke=\"#00ACC1\" stroke-width=\"0.8\"></line><line x1=\"0\" y1=\"0\" x2=\"80\" y2=\"0\" stroke=\"#00796B\" stroke-width=\"0.5\"></line><line x1=\"0\" y1=\"80\" x2=\"80\" y2=\"80\" stroke=\"#00796B\" stroke-width=\"0.5\"></line><line x1=\"40\" y1=\"0\" x2=\"40\" y2=\"80\" stroke=\"#00ACC1\" stroke-width=\"0.8\"></line><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"80\" stroke=\"#00796B\" stroke-width=\"0.5\"></line><line x1=\"80\" y1=\"0\" x2=\"80\" y2=\"80\" stroke=\"#00796B\" stroke-width=\"0.5\"></line><circle cx=\"40\" cy=\"40\" r=\"2.5\" fill=\"#00ACC1\"></circle><circle cx=\"0\" cy=\"0\" r=\"1.5\" fill=\"#00796B\"></circle><circle cx=\"80\" cy=\"0\" r=\"1.5\" fill=\"#00796B\"></circle><circle cx=\"0\" cy=\"80\" r=\"1.5\" fill=\"#00796B\"></circle><circle cx=\"80\" cy=\"80\" r=\"1.5\" fill=\"#00796B\"></circle><circle cx=\"40\" cy=\"0\" r=\"1\" fill=\"#00ACC1\"></circle><circle cx=\"40\" cy=\"80\" r=\"1\" fill=\"#00ACC1\"></circle><circle cx=\"0\" cy=\"40\" r=\"1\" fill=\"#00ACC1\"></circle><circle cx=\"80\" cy=\"40\" r=\"1\" fill=\"#00ACC1\"></circle><line x1=\"30\" y1=\"40\" x2=\"40\" y2=\"40\" stroke=\"#00ACC1\" stroke-width=\"1.2\"></line><line x1=\"40\" y1=\"30\" x2=\"40\" y2=\"40\" stroke=\"#00ACC1\" stroke-width=\"1.2\"></line><line x1=\"55\" y1=\"40\" x2=\"65\" y2=\"40\" stroke=\"#00796B\" stroke-width=\"0.8\"></line><line x1=\"65\" y1=\"30\" x2=\"65\" y2=\"40\" stroke=\"#00796B\" stroke-width=\"0.8\"></line><circle cx=\"65\" cy=\"40\" r=\"1.5\" fill=\"#00796B\"></circle><circle cx=\"65\" cy=\"30\" r=\"1.5\" fill=\"#00796B\"></circle><line x1=\"15\" y1=\"40\" x2=\"25\" y2=\"40\" stroke=\"#00796B\" stroke-width=\"0.8\"></line><line x1=\"15\" y1=\"40\" x2=\"15\" y2=\"50\" stroke=\"#00796B\" stroke-width=\"0.8\"></line><circle cx=\"15\" cy=\"40\" r=\"1.5\" fill=\"#00796B\"></circle><circle cx=\"15\" cy=\"50\" r=\"1.5\" fill=\"#00796B\"></circle></pattern></defs><rect width=\"100%\" height=\"100%\" fill=\"url(#circuit-grid)\"></rect></svg><div class=\"absolute top-1/4 left-1/4 w-96 h-96 bg-teal/10 rounded-full blur-[120px] pointer-events-none\"></div><div class=\"absolute bottom-1/4 right-1/4 w-64 h-64 bg-teal-lt/5 rounded-full blur-[100px] pointer-events-none\"></div><div class=\"relative z-10 max-w-7xl mx-auto px-4 sm:px-6 py-24 grid md:grid-cols-2 gap-12 items-center\"><div><p class=\"section-label mb-4\">// AITRUSTAUDIT.COM</p><h1 class=\"font-display text-white text-4xl md:text-5xl lg:text-6xl font-black leading-tight mb-6 text-glow\">The Learning Platform for AI Security Engineering</h1><p class=\"font-body text-teal-lt text-xl mb-8 leading-relaxed\">Practitioner-level courses, frameworks, and tools for the security professional who has to actually do the work — not just pass a test.</p><div class=\"flex flex-col sm:flex-row gap-4\"><a class=\"inline-flex items-center justify-center bg-teal hover:bg-teal-lt text-white font-display font-bold text-sm px-7 py-4 rounded-lg tracking-wide transition-all duration-200 shadow-lg shadow-teal/30 focus:outline-none focus:ring-2 focus:ring-teal-lt focus:ring-offset-2 focus:ring-offset-navy\" href=\"/course\">Enroll in the Course</a><a class=\"inline-flex items-center justify-center border border-teal-lt/50 hover:border-teal-lt text-teal-lt hover:text-white font-display font-bold text-sm px-7 py-4 rounded-lg tracking-wide transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-teal-lt focus:ring-offset-2 focus:ring-offset-navy\" href=\"/free-risk-overview\">Download Free Risk Overview</a></div></div><div class=\"hidden md:flex items-center justify-center\"><div class=\"relative w-64 h-64\"><div class=\"absolute inset-0 bg-teal/10 rounded-full blur-3xl\"></div><div class=\"absolute inset-0 flex items-center justify-center\"><svg width=\"96\" height=\"96\" viewBox=\"0 0 96 96\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"\" aria-hidden=\"true\" style=\"filter:drop-shadow(0 0 12px rgba(0,200,255,0.6))\"><path d=\"M48 8 L82 22 L82 52 C82 68 66 82 48 88 C30 82 14 68 14 52 L14 22 Z\" stroke=\"#00ACC1\" stroke-width=\"2.5\" fill=\"#0D1B2A\"></path><path d=\"M48 16 L74 28 L74 52 C74 64 62 75 48 80 C34 75 22 64 22 52 L22 28 Z\" fill=\"#00796B\" opacity=\"0.25\"></path><text x=\"48\" y=\"58\" text-anchor=\"middle\" font-family=\"Orbitron, sans-serif\" font-size=\"22\" font-weight=\"700\" fill=\"#00ACC1\" letter-spacing=\"2\">AI</text><circle cx=\"48\" cy=\"8\" r=\"3\" fill=\"#00ACC1\"></circle><circle cx=\"82\" cy=\"22\" r=\"2.5\" fill=\"#00796B\"></circle><circle cx=\"14\" cy=\"22\" r=\"2.5\" fill=\"#00796B\"></circle></svg></div><svg class=\"absolute inset-0 w-full h-full\" viewBox=\"0 0 256 256\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><line x1=\"128\" y1=\"0\" x2=\"128\" y2=\"56\" stroke=\"#00ACC1\" stroke-width=\"1\" opacity=\"0.5\"></line><line x1=\"128\" y1=\"200\" x2=\"128\" y2=\"256\" stroke=\"#00ACC1\" stroke-width=\"1\" opacity=\"0.5\"></line><line x1=\"0\" y1=\"128\" x2=\"56\" y2=\"128\" stroke=\"#00ACC1\" stroke-width=\"1\" opacity=\"0.5\"></line><line x1=\"200\" y1=\"128\" x2=\"256\" y2=\"128\" stroke=\"#00ACC1\" stroke-width=\"1\" opacity=\"0.5\"></line><circle cx=\"128\" cy=\"0\" r=\"4\" fill=\"#00ACC1\" opacity=\"0.7\"></circle><circle cx=\"128\" cy=\"256\" r=\"4\" fill=\"#00ACC1\" opacity=\"0.7\"></circle><circle cx=\"0\" cy=\"128\" r=\"4\" fill=\"#00ACC1\" opacity=\"0.7\"></circle><circle cx=\"256\" cy=\"128\" r=\"4\" fill=\"#00ACC1\" opacity=\"0.7\"></circle></svg></div></div></div></section><div class=\"bg-navy py-10 px-4 w-full\"><div class=\"max-w-6xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-8 text-center\"><div class=\"flex flex-col items-center gap-1\"><span class=\"font-display text-teal-lt text-glow text-4xl md:text-5xl font-black\">8</span><span class=\"font-body text-xs md:text-sm text-gray-400 uppercase tracking-widest font-semibold max-w-[140px] leading-tight\">Core Modules</span></div><div class=\"flex flex-col items-center gap-1\"><span class=\"font-display text-teal-lt text-glow text-4xl md:text-5xl font-black\">35</span><span class=\"font-body text-xs md:text-sm text-gray-400 uppercase tracking-widest font-semibold max-w-[140px] leading-tight\">Practitioner Lessons</span></div><div class=\"flex flex-col items-center gap-1\"><span class=\"font-display text-teal-lt text-glow text-4xl md:text-5xl font-black\">6.5h</span><span class=\"font-body text-xs md:text-sm text-gray-400 uppercase tracking-widest font-semibold max-w-[140px] leading-tight\">Total Runtime</span></div><div class=\"flex flex-col items-center gap-1\"><span class=\"font-display text-teal-lt text-glow text-4xl md:text-5xl font-black\">80%</span><span class=\"font-body text-xs md:text-sm text-gray-400 uppercase tracking-widest font-semibold max-w-[140px] leading-tight\">of AI data leaks come from inside the organization</span></div></div></div><section class=\"bg-light-bg py-20 px-4\"><div class=\"max-w-7xl mx-auto\"><div class=\"text-center mb-12\"><p class=\"section-label mb-3\">// WHAT YOU&#x27;LL LEARN TO FIND</p><h2 class=\"font-display text-navy text-3xl md:text-4xl font-bold mb-4\">The 5 AI Security Risks Every Practitioner Must Know</h2><p class=\"font-body text-mid-gray text-lg max-w-2xl mx-auto\">80% of unauthorized AI activity comes from inside the organization. The course teaches you to find, score, and remediate every one of these risks in a real engagement.</p></div><div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-6\"><div class=\"relative bg-white rounded-lg shadow-md border border-divider overflow-hidden hover:shadow-lg transition-shadow duration-200\" style=\"border-left:4px solid #B71C1C\"><div class=\"p-6\"><div class=\"flex items-center justify-between mb-3\"><span class=\"text-xs font-display font-bold px-2.5 py-1 rounded-full badge-critical\" style=\"letter-spacing:0.08em\">CRITICAL</span><span class=\"text-3xl font-display font-black text-divider\">0<!-- -->1</span></div><h3 class=\"font-display text-navy text-base font-bold mb-2 leading-tight\">Shadow AI: The Invisible Attack Surface</h3><p class=\"text-mid-gray text-sm mb-4 font-body leading-relaxed\">Employees are using ChatGPT, Claude, and dozens of other AI tools that were never approved. Each one is a potential data exfiltration channel you can&#x27;t see, can&#x27;t audit, and can&#x27;t remediate without the right methodology.</p><div class=\"rounded-md p-3 text-sm font-body font-semibold\" style=\"background:#B71C1C18;color:#B71C1C;border-left:3px solid #B71C1C\">How many AI tools is your team using right now — and how many do you actually know about?</div></div></div><div class=\"relative bg-white rounded-lg shadow-md border border-divider overflow-hidden hover:shadow-lg transition-shadow duration-200\" style=\"border-left:4px solid #E65100\"><div class=\"p-6\"><div class=\"flex items-center justify-between mb-3\"><span class=\"text-xs font-display font-bold px-2.5 py-1 rounded-full badge-high\" style=\"letter-spacing:0.08em\">HIGH</span><span class=\"text-3xl font-display font-black text-divider\">0<!-- -->2</span></div><h3 class=\"font-display text-navy text-base font-bold mb-2 leading-tight\">Client Data in AI Training Pipelines</h3><p class=\"text-mid-gray text-sm mb-4 font-body leading-relaxed\">When teams paste client files, contracts, or PII into AI tools, that data may be used to train the model. You need to know how to identify this exposure, assess the contractual risk, and build controls that prevent it.</p><div class=\"rounded-md p-3 text-sm font-body font-semibold\" style=\"background:#E6510018;color:#E65100;border-left:3px solid #E65100\">Are employees inadvertently training AI models on sensitive data without consent?</div></div></div><div class=\"relative bg-white rounded-lg shadow-md border border-divider overflow-hidden hover:shadow-lg transition-shadow duration-200\" style=\"border-left:4px solid #E65100\"><div class=\"p-6\"><div class=\"flex items-center justify-between mb-3\"><span class=\"text-xs font-display font-bold px-2.5 py-1 rounded-full badge-high\" style=\"letter-spacing:0.08em\">HIGH</span><span class=\"text-3xl font-display font-black text-divider\">0<!-- -->3</span></div><h3 class=\"font-display text-navy text-base font-bold mb-2 leading-tight\">No AI Acceptable Use Policy</h3><p class=\"text-mid-gray text-sm mb-4 font-body leading-relaxed\">73% of organizations have no written policy governing AI use. No policy means no accountability and no legal defense when something goes wrong. A practitioner-level course teaches you to build one from scratch.</p><div class=\"rounded-md p-3 text-sm font-body font-semibold\" style=\"background:#E6510018;color:#E65100;border-left:3px solid #E65100\">What happens legally if an employee&#x27;s AI use causes a data breach and there&#x27;s no policy?</div></div></div><div class=\"relative bg-white rounded-lg shadow-md border border-divider overflow-hidden hover:shadow-lg transition-shadow duration-200\" style=\"border-left:4px solid #E65100\"><div class=\"p-6\"><div class=\"flex items-center justify-between mb-3\"><span class=\"text-xs font-display font-bold px-2.5 py-1 rounded-full badge-high\" style=\"letter-spacing:0.08em\">HIGH</span><span class=\"text-3xl font-display font-black text-divider\">0<!-- -->4</span></div><h3 class=\"font-display text-navy text-base font-bold mb-2 leading-tight\">Compliance Exposure (HIPAA, GDPR, SOC 2)</h3><p class=\"text-mid-gray text-sm mb-4 font-body leading-relaxed\">AI tools break existing compliance frameworks in ways current controls don&#x27;t catch. Knowing how to map AI tool usage against HIPAA, GDPR, and SOC 2 obligations is a core practitioner skill.</p><div class=\"rounded-md p-3 text-sm font-body font-semibold\" style=\"background:#E6510018;color:#E65100;border-left:3px solid #E65100\">Have you mapped your AI tool stack against your specific compliance obligations?</div></div></div><div class=\"relative bg-white rounded-lg shadow-md border border-divider overflow-hidden hover:shadow-lg transition-shadow duration-200\" style=\"border-left:4px solid #00ACC1\"><div class=\"p-6\"><div class=\"flex items-center justify-between mb-3\"><span class=\"text-xs font-display font-bold px-2.5 py-1 rounded-full badge-medium\" style=\"letter-spacing:0.08em\">MEDIUM</span><span class=\"text-3xl font-display font-black text-divider\">0<!-- -->5</span></div><h3 class=\"font-display text-navy text-base font-bold mb-2 leading-tight\">Unchecked AI Vendor &amp; Third-Party Risk</h3><p class=\"text-mid-gray text-sm mb-4 font-body leading-relaxed\">Every AI vendor in your stack is a potential supply chain risk. Most organizations have never reviewed an AI vendor&#x27;s security posture, data retention policy, or incident response plan. That&#x27;s a gap this course closes.</p><div class=\"rounded-md p-3 text-sm font-body font-semibold\" style=\"background:#00ACC118;color:#00ACC1;border-left:3px solid #00ACC1\">Who reviewed the security posture of the last AI tool your team adopted?</div></div></div><div class=\"md:col-span-2 lg:col-span-3 bg-navy rounded-lg p-6 flex flex-col md:flex-row items-center justify-between gap-4 border border-teal/30\"><div><p class=\"font-display text-teal-lt text-sm font-bold mb-1\">READY TO BUILD THESE SKILLS?</p><p class=\"font-body text-gray-300\">The course walks you through finding and remediating every one of these risks — with real templates and a methodology you can use on day one.</p></div><a class=\"shrink-0 bg-teal hover:bg-teal-lt text-white font-display font-bold text-sm px-6 py-3 rounded-lg tracking-wide transition-colors whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-teal-lt\" href=\"/course\">See the Curriculum</a></div></div></div></section><section class=\"bg-white py-20 px-4\"><div class=\"max-w-7xl mx-auto\"><div class=\"text-center mb-12\"><p class=\"section-label mb-3\">// WHO THIS COURSE IS FOR</p><h2 class=\"font-display text-navy text-3xl md:text-4xl font-bold\">Built for the Professional Who Has to Do the Work</h2></div><div class=\"grid md:grid-cols-3 gap-6\"><div class=\"relative bg-navy rounded-xl p-8 overflow-hidden hover:shadow-xl hover:shadow-teal/10 transition-shadow\"><div class=\"absolute top-0 left-0 w-full h-1 bg-teal opacity-60\"></div><div class=\"text-4xl mb-4\" aria-hidden=\"true\">🔒</div><h3 class=\"font-display text-teal-lt text-lg font-bold mb-3\">Security Practitioners</h3><p class=\"font-body text-gray-400 text-sm leading-relaxed\">AI just rewrote the threat model. If you can&#x27;t speak fluently to AI risk — shadow AI, LLM prompt injection, model poisoning — you&#x27;re behind. This course gives you the frameworks and practitioner vocabulary to close that gap fast.</p></div><div class=\"relative bg-navy rounded-xl p-8 overflow-hidden hover:shadow-xl hover:shadow-teal/10 transition-shadow\"><div class=\"absolute top-0 left-0 w-full h-1 bg-teal opacity-60\"></div><div class=\"text-4xl mb-4\" aria-hidden=\"true\">📋</div><h3 class=\"font-display text-teal-lt text-lg font-bold mb-3\">Compliance &amp; GRC Teams</h3><p class=\"font-body text-gray-400 text-sm leading-relaxed\">AI broke your existing frameworks before you had time to adapt. NIST CSF doesn&#x27;t cover LLMs. ISO 27001 doesn&#x27;t address training data. This is where you get AI-specific compliance mapping built for the work you actually have to do.</p></div><div class=\"relative bg-navy rounded-xl p-8 overflow-hidden hover:shadow-xl hover:shadow-teal/10 transition-shadow\"><div class=\"absolute top-0 left-0 w-full h-1 bg-teal opacity-60\"></div><div class=\"text-4xl mb-4\" aria-hidden=\"true\">🛠️</div><h3 class=\"font-display text-teal-lt text-lg font-bold mb-3\">Security Engineers</h3><p class=\"font-body text-gray-400 text-sm leading-relaxed\">You&#x27;re building or securing systems that run on AI. Prompt injection, model poisoning, and insecure output handling are real attack vectors — and they require hands-on, engineering-level understanding to address. That&#x27;s exactly what this teaches.</p></div></div></div></section><section class=\"bg-teal py-16 px-4\"><div class=\"max-w-5xl mx-auto\"><div class=\"grid md:grid-cols-2 gap-10 items-center\"><div><p class=\"section-label text-white/70 mb-3\">// FREE RESOURCE</p><h2 class=\"font-display text-white text-2xl md:text-3xl font-bold mb-4 leading-tight\">Start Here: Free AI Security Risk Overview</h2><p class=\"font-body text-teal-bg text-lg mb-6\">Know exactly where the risks are. Zero cost. Used by 500+ security professionals to understand their AI exposure.</p><form class=\"space-y-3\"><div class=\"flex gap-3\"><input type=\"text\" placeholder=\"First name\" class=\"w-1/3 px-4 py-3 rounded-lg bg-white/10 border border-white/30 text-white placeholder-white/50 font-body text-sm focus:outline-none focus:ring-2 focus:ring-white\" value=\"\"/><input type=\"email\" required=\"\" placeholder=\"Email address\" class=\"flex-1 px-4 py-3 rounded-lg bg-white/10 border border-white/30 text-white placeholder-white/50 font-body text-sm focus:outline-none focus:ring-2 focus:ring-white\" value=\"\"/></div><button type=\"submit\" class=\"w-full bg-navy hover:bg-navy/80 text-teal-lt font-display font-bold text-sm py-3 rounded-lg tracking-wide transition-colors focus:outline-none focus:ring-2 focus:ring-white disabled:opacity-60\">Download Free Risk Overview →</button><p class=\"text-xs text-teal-bg/70 font-body text-center\">