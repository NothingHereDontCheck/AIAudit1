l for someone who has to do the actual work. I built this site to be the resource I wish someone had handed me when I started.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"Who This Is For\\\",{\\\"className\\\":\\\"bg-light-bg rounded-xl p-7 border border-divider\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-3xl mb-4\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":\\\"🎯\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-display text-navy text-base font-bold mb-3\\\",\\\"children\\\":\\\"Who This Is For\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-mid-gray text-sm leading-relaxed\\\",\\\"children\\\":\\\"Security practitioners adding AI to their threat model. GRC and compliance teams whose existing frameworks don't cover LLMs. Security engineers building or securing AI-powered systems. Anyone who needs to understand AI risk at a practitioner level — not just in theory.\\\"}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"9:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"relative bg-navy py-20 px-4 overflow-hidden\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L6\\\",null,{\\\"opacity\\\":0.08}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"relative z-10 max-w-3xl mx-auto text-center\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"section-label mb-4\\\",\\\"children\\\":\\\"// FRAMEWORKS \\u0026 STANDARDS\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-display text-white text-2xl font-bold mb-8\\\",\\\"children\\\":\\\"The Curriculum Is Grounded in the Standards That Matter\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex flex-wrap justify-center gap-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",\\\"NIST AI RMF 1.0\\\",{\\\"className\\\":\\\"font-display text-xs font-bold px-4 py-2 rounded-full border border-teal/40 text-teal-lt hover:border-teal-lt transition-colors\\\",\\\"children\\\":\\\"NIST AI RMF 1.0\\\"}],[\\\"$\\\",\\\"span\\\",\\\"OWASP