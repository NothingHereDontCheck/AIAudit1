drop-shadow(0 0 12px rgba(0,200,255,0.6))\"><path d=\"M48 8 L82 22 L82 52 C82 68 66 82 48 88 C30 82 14 68 14 52 L14 22 Z\" stroke=\"#00ACC1\" stroke-width=\"2.5\" fill=\"#0D1B2A\"></path><path d=\"M48 16 L74 28 L74 52 C74 64 62 75 48 80 C34 75 22 64 22 52 L22 28 Z\" fill=\"#00796B\" opacity=\"0.25\"></path><text x=\"48\" y=\"58\" text-anchor=\"middle\" font-family=\"Orbitron, sans-serif\" font-size=\"22\" font-weight=\"700\" fill=\"#00ACC1\" letter-spacing=\"2\">AI</text><circle cx=\"48\" cy=\"8\" r=\"3\" fill=\"#00ACC1\"></circle><circle cx=\"82\" cy=\"22\" r=\"2.5\" fill=\"#00796B\"></circle><circle cx=\"14\" cy=\"22\" r=\"2.5\" fill=\"#00796B\"></circle></svg><div class=\"hidden sm:block\"><span class=\"font-display text-white text-sm font-bold tracking-wide\">AITrustAudit</span><span class=\"font-display text-teal-lt text-sm font-bold\">.com</span></div></a><nav class=\"hidden md:flex items-center gap-1\" aria-label=\"Main navigation\"><a class=\"font-body font-semibold text-sm text-gray-300 hover:text-teal-lt px-3 py-2 rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-teal-lt\" href=\"/resources\">Free Resources</a><a class=\"font-body font-semibold text-sm text-gray-300 hover:text-teal-lt px-3 py-2 rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-teal-lt\" href=\"/course\">Course</a><a class=\"font-body font-semibold text-sm text-gray-300 hover:text-teal-lt px-3 py-2 rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-teal-lt\" href=\"/blog\">Blog</a><a class=\"font-body font-semibold text-sm text-gray-300 hover:text-teal-lt px-3 py-2 rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-teal-lt\" href=\"/about\">About</a></nav><div class=\"hidden md:flex items-center gap-3\"><a class=\"bg-teal hover:bg-teal-lt text-white font-display font-bold text-xs px-4 py-2 rounded-lg tracking-wide transition-colors focus:outline-none focus:ring-2 focus:ring-teal-lt\" href=\"/course\">Enroll Now</a></div><button class=\"md:hidden text-gray-300 hover:text-white focus:outline-none focus:ring-2 focus:ring-teal-lt rounded-md p-1\" aria-label=\"Open menu\" aria-expanded=\"false\"><svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16M4 18h16\"></path></svg></button></div></header><main id=\"main-content\" class=\"pt-16\"><div class=\"min-h-screen bg-white py-16 px-4\"><div class=\"max-w-3xl mx-auto\"><p class=\"section-label mb-3\">// LEGAL</p><h1 class=\"font-display text-navy text-3xl font-bold mb-2\">Privacy Policy</h1><p class=\"font-body text-mid-gray text-sm mb-10\">Effective: <!-- -->May 1, 2026</p><div class=\"prose-article space-y-8 font-body text-mid-gray text-base leading-relaxed\"><section><h2 class=\"font-display text-navy text-xl font-bold mb-3\">Who We Are</h2><p>AITrustAudit.com is an independent education and consulting brand operated by Jamel Rainey. We provide AI security education resources, online courses, and professional AI security audit services for small and medium businesses.</p></section><section><h2 class=\"font-display text-navy text-xl font-bold mb-3\">What Data We Collect</h2><p class=\"mb-3\">We collect the following data when you interact with our site:</p><ul class=\"list-disc pl-6 space-y-2\"><li><strong class=\"text-navy\">Email address and first name</strong> — when you subscribe to our newsletter or download a free resource</li><li><strong class=\"text-navy\">Name and contact information</strong> — when you book a discovery call or request an audit engagement</li><li><strong class=\"text-navy\">Payment information</strong> — processed by Stripe (we never see or store raw card data)</li><li><strong class=\"text-navy\">Website analytics</strong> — aggregated, anonymized traffic data via Plausible Analytics (no IP tracking, no cookies)</li></ul></section><section><h2 class=\"font-display text-navy text-xl font-bold mb-3\">How We Use Your Data</h2><ul class=\"list-disc pl-6 space-y-2\"><li>To deliver requested resources (free PDF, course access, audit report)</li><li>To send The AI Trust Briefing newsletter (only if you opted in)</li><li>To communicate about your audit engagement</li><li>To process course or service payments via Stripe</li><li>To improve our content and services using aggregated analytics</li></ul></section><section><h2 class=\"font-display text-navy text-xl font-bold mb-3\">Email &amp; Newsletter</h2><p>Email list management is handled by ConvertKit. By subscribing, you agree to ConvertKit’s privacy policy. We do not sell, rent, or share email addresses with any third party. You can unsubscribe from any email using the unsubscribe link in the footer of every message.</p></section><section><h2 class=\"font-display text-navy text-xl font-bold mb-3\">Third-Party Services</h2><ul class=\"list-disc pl-6 space-y-2\"><li><strong class=\"text-navy\">Stripe</strong> — payment processing</li><li><strong class=\"text-navy\">ConvertKit</strong> — email list management and newsletter delivery</li><li><strong class=\"text-navy\">Calendly</strong> — discovery call scheduling</li><li><strong class=\"text-navy\">Plausible Analytics</strong> — privacy-first website analytics (no cookies, no IP tracking, GDPR-compliant by default)</li><li><strong class=\"text-navy\">Vercel</strong> — website hosting</li></ul></section><section><h2 class=\"font-display text-navy text-xl font-bold mb-3\">Data Retention</h2><ul class=\"list-disc pl-6 space-y-2\"><li>Email subscribers: retained until unsubscribed</li><li>Audit engagement data: 90 days post-engagement, then securely deleted</li><li>Payment records: retained per Stripe’s standard retention policy (typically 7 years for tax/legal purposes)</li></ul></section><section><h2 class=\"font-display text-navy text-xl font-bold mb-3\">Your Rights</h2><p class=\"mb-3\">Depending on your jurisdiction, you may have the right to:</p><ul class=\"list-disc pl-6 space-y-2\"><li>Access the personal data we hold about you</li><li>Request correction of inaccurate data</li><li>Request deletion of your data</li><li>Object to processing of your data</li><li>Data portability</li></ul><p class=\"mt-3\">To exercise any of these rights, email us at privacy@aitrustaudit.com.</p></section><section><h2 class=\"font-display text-navy text-xl font-bold mb-3\">Cookies</h2><p>We use Plausible Analytics, which is cookieless and does not use browser fingerprinting. We do not place advertising, tracking, or analytics cookies on your device. Functionality cookies may be set by embedded third-party services (Calendly, Stripe checkout).</p></section><section><h2 class=\"font-display text-navy text-xl font-bold mb-3\">Contact</h2><p>Questions about this policy: privacy@aitrustaudit.com</p></section></div></div></div><!--$--><!--/$--></main><footer class=\"bg-navy\" aria-label=\"Site footer\"><div class=\"border-t border-white/10 px-4 py-10\"><div class=\"max-w-4xl mx-auto text-center\"><p class=\"section-label mb-2\">// THE AI TRUST BRIEFING</p><h3 class=\"font-display text-white text-lg font-bold mb-2\">The AI Security Newsletter for Practitioners Who Do the Work</h3><p class=\"font-body text-gray-400 text-sm mb-6\">Real threats. Real frameworks. No enterprise fluff. Weekly.</p><div class=\"max-w-md mx-auto\"><div><form class=\"flex flex-col sm:flex-row gap-3\"><input type=\"email\" required=\"\" placeholder=\"Your email address\" class=\"flex-1 px-4 py-3 rounded-lg bg-navy border border-teal/40 text-white placeholder-gray-500 font-body text-sm focus:outline-none focus:ring-2 focus:ring-teal-lt\" value=\"\"/><button type=\"submit\" class=\"bg-teal hover:bg-teal-lt text-white font-display font-bold text-sm px-6 py-3 rounded-lg tracking-wide transition-colors whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-teal-lt disabled:opacity-60\">Get Free Overview</button></form></div></div></div></div><div class=\"border-t border-white/10 px-4 py-12\"><div class=\"max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-8\"><div class=\"col-span-2 md:col-span-1\"><a class=\"flex items-center gap-2 mb-3 focus:outline-none focus:ring-2 focus:ring-teal-lt rounded-md w-fit\" href=\"/\"><svg width=\"32\" height=\"32\" viewBox=\"0 0 96 96\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"\" aria-hidden=\"true\" style=\"filter:drop-shadow(0 0 12px rgba(0,200,255,0.6))\"><path d=\"M48 8 L82 22 L82 52 C82 68 66 82 48 88 C30 82 14 68 14 52 L14 22 Z\" stroke=\"#00ACC1\" stroke-width=\"2.5\" fill=\"#0D1B2A\"></path><path d=\"M48 16 L74 28 L74 52 C74 64 62 75 48 80 C34 75 22 64 22 52 L22 28 Z\" fill=\"#00796B\" opacity=\"0.25\"></path><text x=\"48\" y=\"58\" text-anchor=\"middle\" font-family=\"Orbitron, sans-serif\" font-size=\"22\" font-weight=\"700\" fill=\"#00ACC1\" letter-spacing=\"2\">AI</text><circle cx=\"48\" cy=\"8\" r=\"3\" fill=\"#00ACC1\"></circle><circle cx=\"82\" cy=\"22\" r=\"2.5\" fill=\"#00796B\"></circle><circle cx=\"14\" cy=\"22\" r=\"2.5\" fill=\"#00796B\"></circle></svg><span class=\"font-display text-white text-sm font-bold\">AITrustAudit<span class=\"text-teal-lt\">.com</span></span></a><p class=\"font-body text-gray-500 text-sm leading-relaxed mb-3\">Securing the Intelligent Future</p><p class=\"font-body text-gray-600 text-xs\">Jamel Rainey · AI Security Leader</p></div><div><h4 class=\"font-display text-gray-400 text-xs font-bold uppercase tracking-widest mb-4\">Learn</h4><ul class=\"space-y-2\"><li><a class=\"font-body text-gray-500 hover:text-teal-lt text-sm transition-colors focus:outline-none focus:text-teal-lt\" href=\"/resources\">Free Resources</a></li><li><a class=\"font-body text-gray-500 hover:text-teal-lt text-sm transition-colors focus:outline-none focus:text-teal-lt\" href=\"/course\">Course</a></li><li><a class=\"font-body text-gray-500 hover:text-teal-lt text-sm transition-colors focus:outline-none focus:text-teal-lt\" href=\"/blog\">Blog</a></li></ul></div><div><h4 class=\"font-display text-gray-400 text-xs font-bold uppercase tracking-widest mb-4\">Company</h4><ul class=\"space-y-2\"><li><a class=\"font-body text-gray-500 hover:text-teal-lt text-sm transition-colors focus:outline-none focus:text-teal-lt\" href=\"/about\">About Jamel Rainey</a></li><li><a class=\"font-body text-gray-500 hover:text-teal-lt text-sm transition-colors focus:outline-none focus:text-teal-lt\" href=\"/privacy\">Privacy Policy</a></li></ul></div></div></div><div class=\"border-t border-white/10 px-4 py-5\"><div class=\"max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-3 text-xs font-body text-gray-600\"><p>© <!-- -->2026<!-- --> AITrustAudit.com · Jamel Rainey</p><p class=\"text-center\">AITrustAudit.com is an independent education and consulting brand. Not affiliated with NIST, OWASP, or ISO.</p><a class=\"hover:text-gray-400 transition-colors focus:outline-none focus:text-teal-lt\" href=\"/privacy\">Privacy Policy</a></div></div></footer><script src=\"/_next/static/chunks/webpack-2eb758dea75faf50.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[1398,[\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-e443009e831b17b8.js\\\"],\\\"default\\\"]\\n3:I[9766,[],\\\"\\\"]\\n4:I[8924,[],\\\"\\\"]\\n5:I[8455,[\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-e443009e831b17b8.js\\\"],\\\"default\\\"]\\n10:I[7150,[],\\\"\\\"]\\n:HL[\\\"/_next/static/css/c098a84fd5ac198d.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"0:{\\\"P\\\":null,\\\"b\\\":\\\"o-A0Dy6wl3WXzOvqP2U7x\\\",\\\"p\\\":\\\"\\\",\\\"c\\\":[\\\"\\\",\\\"privacy\\\"],\\\"i\\\":false,\\\"f\\\":[[[\\\"\\\",{\\\"children\\\":[\\\"privacy\\\",{\\\"children\\\":[\\\"__PAGE__\\\",{}]}]},\\\"$undefined\\\",