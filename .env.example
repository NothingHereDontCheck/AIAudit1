# -------------------------------------------------------
# AITrustAudit.com — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# -------------------------------------------------------

# ConvertKit (email list / newsletter)
# Found at: https://app.convertkit.com/account/edit -> API Keys
CONVERTKIT_API_KEY=your_convertkit_api_key_here

# ConvertKit Form ID for the "AI Trust Briefing" form
# Found at: https://app.convertkit.com/forms -> your form -> URL contains the ID
CONVERTKIT_FORM_ID=your_form_id_here

# Stripe (course + template payments)
# Found at: https://dashboard.stripe.com/apikeys
# IMPORTANT: Use NEXT_PUBLIC_ prefix only for the publishable key — never for secret key
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Plausible Analytics (privacy-first, no cookies)
# Set to your Cloudflare Pages domain or custom domain
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=aitrustaudit.com

# Calendly booking URL (for discovery call CTAs)
# Replace the placeholder https://calendly.com links in page files with this
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/jamelrainey/discovery
